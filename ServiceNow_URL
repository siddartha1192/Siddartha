# - Table: cmdb_ci_win_server (Windows servers in CMDB)
# - Filters:
#   - active=true: Only active records
#   - u_decommission_dateISNOTEMPTY: Only servers with a decommission date
#   - dns_domain=testdev.local: Only servers in the 'testdev.local' domain
# - Limit: 100000 records

